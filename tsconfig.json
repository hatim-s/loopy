{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "react": ["./apps/studio/node_modules/@types/react/index.d.ts"],
      "react/*": ["./apps/studio/node_modules/@types/react/*"],
      "react-dom": ["./apps/studio/node_modules/@types/react-dom/index.d.ts"],
      "react-dom/*": ["./apps/studio/node_modules/@types/react-dom/*"]
    }
  },
  "include": ["apps", "packages", "vitest.config.ts", "vitest.setup.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "loopy": ["./packages/loopy/src/core/index.ts"],
      "loopy/runtime": ["./packages/loopy/src/runtime/index.ts"],
      "loopy/local": ["./packages/loopy/src/local/index.ts"],
      "loopy/cloud": ["./packages/loopy/src/cloud/index.ts"]
    },
    "skipLibCheck": true,
    "types": ["bun-types"]
  },
  "include": ["packages", "apps", "scripts", "examples"],
  "exclude": ["node_modules", "**/dist"]
}

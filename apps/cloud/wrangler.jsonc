{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "loopy-cloud-phase1-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACES", "class_name": "Workspace" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Workspace"] }],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "loopy-phase1-artifacts-local" }],
  "vars": {
    "LOOPY_STAGE": "local",
    "SANDBOX_URL": "http://127.0.0.1:14871",
    "CONCURRENCY": "4"
  },
  "dev": { "ip": "127.0.0.1", "port": 14870, "inspector_port": 14873 }
}

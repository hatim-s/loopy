{
  "name": "loopy-workspace",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "effect": "4.1.2",
      "oxc-parser": "0.154.0"
    }
  },
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun packages/cli/src/index.ts ui",
    "loopy": "bun packages/cli/src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.portable.json && bun run diagnostics:effect",
    "diagnostics:effect": "node --preserve-symlinks-main node_modules/@effect/language-service/cli.js diagnostics --project tsconfig.json --format text",
    "test": "bun test --timeout 60000 ./apps/dashboard/_tests_ ./packages/loopy/_tests_ ./apps/cloud/_tests_",
    "check": "bun run build && bun run lint && bun run typecheck && bun run test",
    "build": "bun scripts/build.ts",
    "install:global": "bun scripts/install-global.ts",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "lint": "biome check . && eslint . && node tools/anti-slop/_tests_/run.mjs",
    "cloud:start": "bun --no-env-file apps/cloud/dev/dev.ts",
    "cloud:build-sandbox": "bun --no-env-file apps/cloud/dev/stack/build-sandbox.ts",
    "acceptance:local": "bun --no-env-file packages/loopy/_tests_/acceptance/run.ts",
    "acceptance:package": "bun run build && bun --no-env-file packages/loopy/_tests_/acceptance/package.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@cloudflare/workers-types": "5.20261022.1",
    "@effect/language-service": "0.87.5",
    "@loopy/cli": "workspace:*",
    "@loopy/compiler": "workspace:*",
    "@loopy/contract": "workspace:*",
    "@loopy/core": "workspace:*",
    "@loopy/runtime": "workspace:*",
    "@loopy/sdk": "workspace:*",
    "bun-types": "1.4.0",
    "effect": "catalog:",
    "eslint": "10.8.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "77.0.0",
    "loopy": "workspace:*",
    "miniflare": "4.20260730.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.66.0",
    "wrangler": "4.152.0",
    "zod": "4.6.7"
  }
}

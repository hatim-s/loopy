{
  "name": "loopy-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun packages/loopy/src/cli/index.ts ui",
    "loopy": "bun packages/loopy/src/cli/index.ts",
    "typecheck": "tsc --noEmit && tsc -p packages/loopy/tsconfig.portable.json",
    "test": "bun test packages/loopy/_tests_",
    "check": "bun run build && bun run lint && bun run typecheck && bun run test",
    "build": "bun scripts/build.ts",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "bun-types": "1.4.0",
    "loopy": "workspace:*",
    "typescript": "5.9.2"
  }
}

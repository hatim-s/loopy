{
  "name": "loopy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first workflow runtime, recorder, extractor, and visual debugger for coding agents.",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run typecheck",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "bun-types": "1.3.9",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}

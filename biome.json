{
  "$schema": "https://biomejs.dev/schemas/2.2.2/schema.json",
  "files": {
    "includes": [
      "**",
      "!bun.lock",
      "!**/node_modules",
      "!**/dist",
      "!coverage",
      "!.loopy",
      "!tools/anti-slop",
      "!research",
      "!.notes",
      "!**/routeTree.gen.ts",
      "!**/.wrangler"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "overrides": [
    {
      "includes": [
        ".notes/cloud/evidence/architecture/**",
        ".notes/cloud/architecture/evidence/**"
      ],
      "files": { "maxSize": 16777216 },
      "formatter": { "enabled": false }
    }
  ],
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": false
  }
}

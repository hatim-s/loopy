{
  "name": "loopy",
  "version": "0.3.0",
  "type": "module",
  "description": "TypeScript workflows for local CLI tools, with durable runs and a graph viewer.",
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "exports": {
    ".": {
      "types": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    },
    "./local": {
      "types": "./dist/types/local/index.d.ts",
      "default": "./src/local/index.ts"
    },
    "./cloud": {
      "types": "./src/cloud/index.ts",
      "default": "./src/cloud/index.ts"
    }
  },
  "bin": {
    "loopy": "./src/cli/index.ts"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "bun ../../scripts/build.ts"
  }
}

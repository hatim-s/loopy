{
  "name": "loopy",
  "version": "0.4.0",
  "type": "module",
  "description": "Replayable TypeScript workflows with durable runs, a local daemon and a live dashboard.",
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types/loopy/src/index.d.ts",
      "default": "./dist/loopy/src/index.js"
    },
    "./local": {
      "types": "./dist/types/loopy/src/local.d.ts",
      "default": "./dist/loopy/src/local.js"
    },
    "./contract": {
      "types": "./dist/types/loopy/src/contract.d.ts",
      "default": "./dist/loopy/src/contract.js"
    },
    "./engine": {
      "types": "./dist/types/loopy/src/engine.d.ts",
      "default": "./dist/loopy/src/engine.js"
    }
  },
  "bin": {
    "loopy": "./dist/cli/src/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "bun ../../scripts/build.ts"
  },
  "dependencies": {
    "effect": "catalog:",
    "oxc-parser": "catalog:"
  },
  "devDependencies": {
    "@loopy/core": "workspace:*",
    "@loopy/contract": "workspace:*",
    "@loopy/sdk": "workspace:*",
    "@loopy/runtime": "workspace:*",
    "@loopy/compiler": "workspace:*",
    "@loopy/cli": "workspace:*"
  }
}

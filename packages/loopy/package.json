{
  "name": "loopy",
  "version": "0.4.0",
  "type": "module",
  "description": "Replayable TypeScript workflows with durable runs, a local daemon and a live dashboard.",
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    },
    "./local": {
      "types": "./dist/types/local/index.d.ts",
      "default": "./dist/local/index.js"
    },
    "./contract": {
      "types": "./dist/types/contract/index.d.ts",
      "default": "./dist/contract/index.js"
    },
    "./graph": {
      "types": "./dist/types/sdk/graph/index.d.ts",
      "default": "./dist/sdk/graph/index.js"
    },
    "./engine": {
      "types": "./dist/types/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    }
  },
  "bin": {
    "loopy": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "bun ../../scripts/build.ts"
  },
  "dependencies": {
    "oxc-parser": "^0.154.0",
    "zod": "4.6.7"
  }
}

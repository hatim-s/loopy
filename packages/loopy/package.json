{
  "name": "loopy",
  "version": "0.3.0",
  "type": "module",
  "description": "TypeScript workflows for local CLI tools, with durable runs and a graph viewer.",
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./runtime": {
      "types": "./dist/types/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./local": {
      "types": "./dist/types/local/index.d.ts",
      "default": "./dist/local/index.js"
    },
    "./cloud": {
      "types": "./dist/types/cloud/index.d.ts",
      "default": "./dist/cloud/index.js"
    },
    "./application": {
      "types": "./dist/types/application/index.d.ts",
      "default": "./dist/application/index.js"
    },
    "./protocol": {
      "types": "./dist/types/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./storage": {
      "types": "./dist/types/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./modal": {
      "types": "./dist/types/providers/modal.d.ts",
      "default": "./dist/providers/modal.js"
    }
  },
  "bin": {
    "loopy": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "bun ../../scripts/build.ts"
  },
  "dependencies": {
    "modal": "0.11.0"
  }
}

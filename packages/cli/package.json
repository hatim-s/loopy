{
  "name": "loopy",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "bin": {
    "loopy": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.js --target bun",
    "prepack": "bun scripts/build-package.ts",
    "smoke:package": "bun scripts/package-smoke.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@loopy/contracts": "workspace:*",
    "@loopy/extractor": "workspace:*",
    "@loopy/local-api": "workspace:*",
    "@loopy/platform": "workspace:*",
    "@loopy/providers": "workspace:*",
    "@loopy/runtime": "workspace:*",
    "@loopy/scheduler": "workspace:*",
    "@loopy/storage": "workspace:*",
    "@loopy/testing": "workspace:*"
  }
}
